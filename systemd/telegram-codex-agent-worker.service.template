[Unit]
Description=Telegram Codex Agent Worker
After=network-online.target telegram-codex-agent-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
Environment=PYTHONPATH=@ROOT@/src
ExecStart=/usr/bin/env python3 -m telegram_codex_agent.runtime worker
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=default.target
