# The root .env is the only configuration source. Do not commit it.
APP_ENV=development
LOG_LEVEL=INFO
RUNTIME_DIR=runtime
VOICE_AGENT_UAG_PORT=18081

# Copy the values from the existing Telethon account configuration without printing them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=0
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_RDNS=true
# Docker must not use a host-loopback proxy address. Set these when the proxy
# is exposed to containers (for example, host.docker.internal and a forwarded port).
TELEGRAM_PROXY_HOST_DOCKER=host.docker.internal
TELEGRAM_PROXY_PORT_DOCKER=0

# The assistant refuses outbound calls except to these numeric Telegram user IDs.
VOICE_AGENT_ALLOWED_PEER_IDS=
VOICE_AGENT_TEST_PEER_USERNAME=we_are_waiting_for_him
VOICE_AGENT_INBOUND_ENABLED=false
VOICE_AGENT_INBOUND_USERNAME=we_are_waiting_for_him
VOICE_AGENT_REQUIRE_DISCLOSURE=true
VOICE_AGENT_RECORDING_MODE=transcript_only
VOICE_AGENT_MAX_TURN_SECONDS=45
VOICE_AGENT_CALL_TIMEOUT_SEC=120
VOICE_AGENT_MAX_HISTORY_MESSAGES=12
VOICE_AGENT_LANGUAGE=fa
# Streaming VAD: lower end silence responds faster; higher values avoid interrupting pauses.
VOICE_AGENT_VAD_START_RMS=350
VOICE_AGENT_VAD_CONTINUE_RMS=240
VOICE_AGENT_VAD_START_MS=80
VOICE_AGENT_VAD_END_SILENCE_MS=600
VOICE_AGENT_VAD_MIN_UTTERANCE_MS=250
VOICE_AGENT_VAD_PRE_ROLL_MS=200
VOICE_AGENT_AUDIO_SAMPLE_RATE=48000
VOICE_AGENT_AUDIO_CHANNELS=1
VOICE_AGENT_SYSTEM_PROMPT=You are a helpful general voice assistant. Be concise, truthful, and say that you are an automated assistant when asked.

# Ajil Unified AI Gateway. Copy the UAG_* values from ../Gerdoo_AI/.env.
UAG_BASE_URL=http://uag-gateway:8080
UAG_CHAT_ENDPOINT=/v1/chat/completions
UAG_AUDIO_TRANSCRIPTIONS_ENDPOINT=/v1/audio/transcriptions
UAG_AUTH_TOKEN=
UAG_AUTH_HEADER_NAME=x-api-token
UAG_TIMEOUT_SEC=45
AI_CHAT_MODELS=
AI_CHAT_PROVIDERS=
AI_TRANSCRIPTION_PROVIDER=groq
AI_TRANSCRIPTION_MODELS=

# Edge TTS and audio conversion.
EDGE_TTS_VOICE=fa-IR-DilaraNeural
EDGE_TTS_RATE=+0%
FFMPEG_BIN=ffmpeg

# Auditing. JSONL event records never include conversation content; transcript_only
# additionally stores transcript/reply text in SQLite. Call media is temporary.
AUDIT_DATABASE_PATH=runtime/voice_agent.sqlite3
AUDIT_JSONL_PATH=runtime/events.jsonl
